# Copiar como .env y completar. El .env no se sube al repositorio.

# Conexion a la base de datos que levanta el repositorio pedidos360-data.
# El host es el nombre del contenedor porque comparten la red pedidos360-network.
DATASOURCE_URL=jdbc:postgresql://pedidos360-db:5432/pedidos360
POSTGRES_USER=
POSTGRES_PASSWORD=

# Identidad. Los tres valores salen del registro de la aplicacion en Microsoft Entra ID.
AZURE_ISSUER_URI=https://login.microsoftonline.com/TU_TENANT_ID/v2.0
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Origenes autorizados a llamar a los microservicios, separados por coma.
# En local es el servidor de Vite; en la nube, el dominio del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173
