# Copiar como .env y completar. El .env no se sube al repositorio.

# Conexion a la base de datos del repositorio Data-Ecommerce.
# En local, si ambos compose corren en la misma maquina, se puede usar el nombre
# del contenedor (pedidos360-db). En AWS es la IP privada de la instancia de datos.
DATASOURCE_URL=jdbc:postgresql://pedidos360-db:5432/pedidos360
POSTGRES_USER=
POSTGRES_PASSWORD=

# RabbitMQ del mismo repositorio Data-Ecommerce. Mismo criterio que la base:
# nombre de contenedor en local, IP privada en AWS.
RABBITMQ_HOST=pedidos360-rabbitmq
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# SMTP para ms-notificaciones. Cualquier proveedor que soporte SMTP con STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Identidad. Los tres valores salen del registro de la aplicacion en Microsoft Entra ID.
AZURE_ISSUER_URI=https://login.microsoftonline.com/TU_TENANT_ID/v2.0
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Origenes autorizados a llamar a los microservicios, separados por coma.
# En local es el servidor de Vite; en la nube, el dominio del API Gateway del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173
